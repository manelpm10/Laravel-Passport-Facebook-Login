{
    "name": "manelpm10/laravel-passport-facebook-login",
    "description": "Facebook Token Request Grant for Laravel Passport",
    "license": "MIT",
    "keywords": ["laravel", "lumen", "passport", "oauth", "grant"],
    "authors": [
        {
            "name": "Jacob Morris",
            "email": "jacob@mirk.co"
        },
        {
            "name": "Daniel Dewhurst",
            "email": "danjdewhurst@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Danjdewhurst\\PassportFacebookLogin\\": "src"
        }
    },
    "require": {
        "laravel/passport": "^12.4",
        "janu-software/facebook-php-sdk": "^0.4",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Danjdewhurst\\PassportFacebookLogin\\FacebookLoginGrantProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
